{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uptime-zero",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "head_sampling_rate": 0.25,
      "invocation_logs": false,
    },
    "traces": {
      "head_sampling_rate": 0.25,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime-zero",
      // Create your own D1 database with `pnpm wrangler d1 create uptime-zero`
      // and paste the returned database_id here before deploying.
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "drizzle",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MonitorActor"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SchedulerActor"],
    },
    {
      "tag": "v3",
      "deleted_classes": ["MonitorActor"],
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER_ACTOR",
        "class_name": "SchedulerActor",
      },
    ],
  },
}
