{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uptime-zero",
  "main": "src/server/index.ts",
  "account_id": "070a91f36bb99185a44495c5dc870132",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": {
      "head_sampling_rate": 1,
    },
  },
  "triggers": {
    "crons": ["* * * * *", "0 2 * * *"],
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // Create your own D1 database with `pnpm wrangler d1 create uptime-zero`
      // and paste the returned database_id here before deploying.
      "database_id": "aec0bdce-7207-4445-adee-033194c52979",
      "database_name": "uptime-zero",
      "migrations_dir": "src/server/db/migrations",
      "migrations_pattern": "src/server/db/migrations/*/migration.sql",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MonitorActor"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SchedulerActor"],
    },
    {
      "tag": "v3",
      "deleted_classes": ["MonitorActor"],
    },
    { "tag": "v4", "new_sqlite_classes": ["NotificationActor"] },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NOTIFICATION_ACTOR", "class_name": "NotificationActor" },
      {
        "name": "SCHEDULER_ACTOR",
        "class_name": "SchedulerActor",
      },
    ],
  },
}
