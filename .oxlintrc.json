{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agents/**",
    ".wrangler/**",
    "dist/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "public/app.css",
    "worker-configuration.d.ts"
  ],
  "rules": {
    "@typescript-eslint/consistent-type-imports": "error",
    "@typescript-eslint/no-explicit-any": "off"
  }
}
