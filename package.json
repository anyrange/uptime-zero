{
  "name": "uptime-zero",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run paraglide:compile && void prepare && tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --headed --debug",
    "e2e:prepare": "node ./e2e/support/reset-state.mjs",
    "lint": "pnpm run paraglide:compile && oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "pnpm run paraglide:compile && void prepare && tsc --noEmit",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "test": "pnpm run paraglide:compile && void prepare && vitest run",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "db:reset": "void db reset",
    "deploy": "void deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/drizzle-adapter": "^1.6.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@inlang/paraglide-js": "^2.18.2",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "0.45.4",
    "kysely": "0.28.17",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.0",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/runner": "^4.1.8",
    "@vitest/snapshot": "^4.1.8",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "void": "^1.1.11",
