{
  "name": "uptime-zero",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run paraglide:compile && tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev --test-scheduled --port 8788",
    "lint": "pnpm run paraglide:compile && oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "pnpm run paraglide:compile && tsc --noEmit",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "test": "pnpm run paraglide:compile && vitest run",
    "cf-typegen": "wrangler types ./worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrations:prepare": "find drizzle -mindepth 2 -name '*.sql' -exec sh -c 'cp \"$1\" \"drizzle/$(basename \"$(dirname \"$1\")\").sql\"' _ {} \\;",
    "db:migrations:cleanup": "rm drizzle/*.sql",
    "db:migrate": "pnpm run db:migrations:prepare && sh -c 'wrangler d1 migrations apply DB --local; status=$?; pnpm run db:migrations:cleanup; exit $status'",
    "db:migrate-remote": "pnpm run db:migrations:prepare && sh -c 'wrangler d1 migrations apply DB --remote; status=$?; pnpm run db:migrations:cleanup; exit $status'",
    "deploy": "pnpm run db:migrate-remote && pnpm run build && wrangler deploy --config dist/uptime_zero/wrangler.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@hono/zod-validator": "^0.8.0",
    "@inlang/paraglide-js": "^2.18.2",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "@uidotdev/usehooks": "^2.4.1",
    "better-all": "^0.0.7",
    "better-auth": "^1.6.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "1.0.0-beta.22",
    "evlog": "^2.18.1",
    "hono": "^4.12.23",
    "jotai": "^2.20.0",
    "kysely": "0.28.17",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/runner": "^4.1.8",
    "@vitest/snapshot": "^4.1.8",
    "drizzle-kit": "1.0.0-beta.22",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
